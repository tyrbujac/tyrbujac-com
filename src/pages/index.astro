---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { Image } from 'astro:assets';

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Tyr Bujac — Full-Stack Developer"
  description="Final-year Computer Science student at the University of Liverpool, moving to Barcelona after graduation. I design and build software, mostly open-source creative tools."
>
  <Fragment slot="header-inner">
    <div>
      <h1>Tyr Bujac</h1>
      <p>Full-stack Developer</p>
    </div>
    <nav>
      <a href="/projects/">Projects</a>
      <a href="/blog/">Blog</a>
    </nav>
  </Fragment>

  <section id="about">
    <p>
      Final-year Computer Science student at the University of Liverpool, moving to Barcelona after graduation. I design and build software, mostly open-source creative tools.
    </p>
  </section>

  <section id="projects">
    <h2>Projects</h2>

    {projects.map((project) => (
      <article>
        <h3>{project.name}</h3>
        <Image src={project.image} alt={project.imageAlt} width={480} loading="lazy" class="project-image" />
        <p>{project.description}</p>
        <div class="project-links">
          {project.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section id="blog">
    <h2>Blog</h2>
    {posts.map((post) => {
      const d = post.data.date;
      const dateStr = `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
      const dateIso = d.toISOString().split('T')[0];
      return (
        <article>
          <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
          <time datetime={dateIso}>{dateStr}</time>
        </article>
      );
    })}
  </section>
</Base>
