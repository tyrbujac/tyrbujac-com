---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---

<Base
  title="Projects — Tyr Bujac"
  description="Projects by Tyr Bujac. Currently: Igni, a UI-first language for Flutter; Boojy Audio, a DAW for the gap between GarageBand and Ableton; and Pomodonut, a Pomodoro timer."
>
  <section>
    <h2>Projects</h2>

    {projects.map((project) => (
      <article>
        <h3>{project.name}</h3>
        <p>{project.description}</p>
        <div class="project-links">
          {project.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </article>
    ))}
  </section>
</Base>
